---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Pass true on full-width pages (homepage) to skip the site-shell wrapper */
	fullWidth?: boolean;
}

const { title, pageTitle, description, image, canonical, content, fullWidth } = Astro.props;
const { siteTitle, siteTagline, siteLogo, siteFavicon } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{siteFavicon && <link rel="icon" href={siteFavicon} />}
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter+Tight:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
		<EmDashHead page={pageCtx} />
		<style is:global>
			/* ─────────────────────────────────────────────────────────
			   Design tokens — Editorial dark theme
			───────────────────────────────────────────────────────── */
			:root {
				/* Backgrounds */
				--bg:            #0f0d0b;
				--bg-2:          #161310;
				--bg-off:        #1a1613;
				--bg-dark:       #0b0907;
				--surface:       #161310;

				/* Text */
				--text:          #ece5d8;
				--text-inv:      #0f0d0b;
				--fg-dim:        #a09788;
				--muted:         #6b6357;
				--muted-inv:     #a09788;

				/* Accent — warm terracotta */
				--accent:        #c85c3c;
				--accent-light:  #e07050;
				--accent-hover:  #a8432d;
				--accent-wash:   rgba(200, 92, 60, 0.06);
				--accent-fg:     #0f0d0b;

				/* Lines */
				--line:          #2a251f;
				--line-2:        #3a332b;
				--line-dark:     #2a251f;

				/* Radius & shadow */
				--radius:        2px;
				--radius-lg:     4px;
				--shadow:        0 1px 6px rgba(0,0,0,.25);
				--shadow-md:     0 4px 18px rgba(0,0,0,.35);
				--shadow-lg:     0 12px 40px rgba(0,0,0,.45);

				/* Fonts */
				--font-display:  'Fraunces', 'Cormorant Garamond', Georgia, serif;
				--font-body:     'Inter Tight', 'Helvetica Neue', sans-serif;
				--font-mono:     'JetBrains Mono', ui-monospace, monospace;

				/* Booking theme bridge */
				--bk-fg:         var(--text);
				--bk-bg:         var(--bg);
				--bk-mute:       var(--muted);
				--bk-line:       var(--line);
				--bk-accent:     var(--accent);
				--bk-accent-fg:  var(--accent-fg);
				--bk-accent-wash: var(--accent-wash);
				--bk-font-display: var(--font-display);
				--bk-font-body:  var(--font-body);
				--bk-font-mono:  var(--font-mono);
			}

			/* ─── Reset ───────────────────────────────────────── */
			*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

			html { scroll-behavior: smooth; }

			body {
				font-family: var(--font-body);
				color: var(--text);
				background: var(--bg);
				min-height: 100vh;
				font-size: 16px;
				line-height: 1.55;
				-webkit-font-smoothing: antialiased;
				overflow-x: clip;
			}

			a { color: inherit; text-decoration: none; }

			img { display: block; max-width: 100%; height: auto; }

			h1, h2, h3, h4 {
				font-family: var(--font-display);
				line-height: 1.05;
				font-weight: 300;
				letter-spacing: -0.02em;
			}

			/* ─── Layout ──────────────────────────────────────── */
			.site-shell {
				width: min(1200px, 92vw);
				margin: 0 auto;
			}

			.ed-shell {
				max-width: 1440px;
				margin: 0 auto;
				padding: 0 44px;
			}

			.full-bleed { width: 100vw; margin-left: calc(-50vw + 50%); }

			/* ─── Mono / Eyebrow ──────────────────────────────── */
			.ed-mono {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 2px;
				text-transform: uppercase;
				color: var(--muted);
				font-weight: 400;
			}

			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 400;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.6rem;
			}

			/* ─── Nav ─────────────────────────────────────────── */
			.ed-nav {
				position: fixed; top: 0; left: 0; right: 0;
				z-index: 200;
				padding: 22px 0;
				transition: background .3s, padding .3s, border-color .3s;
				border-bottom: 1px solid transparent;
			}

			.ed-nav.is-scrolled {
				background: color-mix(in oklab, var(--bg) 88%, transparent);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				padding: 14px 0;
				border-bottom-color: var(--line);
			}

			.ed-nav-inner {
				max-width: 1440px;
				margin: 0 auto;
				padding: 0 44px;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 24px;
			}

			.ed-logo {
				display: flex;
				align-items: center;
			}

			.ed-logo img {
				height: 34px;
				width: auto;
				filter: brightness(0) invert(1);
			}

			.ed-logo-text {
				font-family: var(--font-display);
				font-size: 1rem;
				font-weight: 300;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text);
			}

			.ed-nav-links {
				display: flex;
				gap: 36px;
				justify-content: center;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 2px;
				text-transform: uppercase;
			}

			.ed-nav-links a {
				color: var(--fg-dim);
				text-decoration: none;
				transition: color .2s;
			}

			.ed-nav-links a:hover { color: var(--accent); }

			.ed-nav-right {
				justify-self: end;
				display: flex;
				align-items: center;
				gap: 16px;
			}

			.nav-cart {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				color: var(--fg-dim);
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 1px;
				transition: color .2s;
			}

			.nav-cart:hover { color: var(--accent); }

			.cart-count {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 16px;
				height: 16px;
				background: var(--accent);
				color: var(--accent-fg);
				border-radius: 0;
				font-size: 0.6rem;
				font-weight: 700;
				padding: 0 3px;
			}

			.cart-count[data-count="0"] { display: none; }

			.nav-book {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 2px;
				text-transform: uppercase;
				padding: 12px 20px;
				background: var(--accent);
				color: var(--accent-fg);
				text-decoration: none;
				transition: filter .2s;
			}

			.nav-book:hover { filter: brightness(1.1); }

			/* ─── Main ────────────────────────────────────────── */
			main { padding-top: 0; }

			/* ─── Sections ────────────────────────────────────── */
			.ed-section {
				max-width: 1440px;
				margin: 0 auto;
				padding: 120px 44px;
				border-bottom: 1px solid var(--line);
			}

			.ed-section-head { margin-bottom: 80px; display: flex; flex-direction: column; gap: 24px; }

			.ed-h2 {
				font-family: var(--font-display);
				font-weight: 300;
				font-size: clamp(38px, 5.5vw, 72px);
				line-height: 1.02;
				letter-spacing: -0.02em;
				margin: 0;
				font-variation-settings: "SOFT" 100, "opsz" 144;
			}

			.ed-display-italic {
				font-style: italic;
				color: var(--accent);
			}

			/* ─── Page sections (inner pages) ─────────────────── */
			.page-section { padding: 4rem 0; }
			.page-section-sm { padding: 2.5rem 0; }

			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				margin-bottom: 2.25rem;
				gap: 1rem;
			}

			.section-header h2 { font-size: clamp(1.6rem, 3vw, 2rem); }

			.view-all {
				font-size: 0.8rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--muted);
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-color: var(--line-2);
				transition: color 0.2s, text-decoration-color 0.2s;
				white-space: nowrap;
			}

			.view-all:hover { color: var(--text); text-decoration-color: var(--muted); }

			/* ─── Grid ────────────────────────────────────────── */
			.grid { display: grid; gap: 1.25rem; }
			.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
			.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

			/* ─── Cards ───────────────────────────────────────── */
			.card {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				padding: 1.5rem;
			}

			.service-card {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow);
				transition: box-shadow 0.25s, transform 0.25s;
			}

			.service-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

			.product-card {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow);
				display: flex;
				flex-direction: column;
				transition: box-shadow 0.25s, transform 0.25s;
			}

			.product-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

			.product-card-body {
				padding: 1.25rem 1.4rem 1.4rem;
				display: flex;
				flex-direction: column;
				flex: 1;
				gap: 0.35rem;
			}

			.product-card h3 { font-size: 1.05rem; }
			.product-card p { color: var(--muted); font-size: 0.875rem; line-height: 1.55; }

			.product-card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-top: auto;
				padding-top: 0.75rem;
				border-top: 1px solid var(--line);
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			/* ─── Price / badges ──────────────────────────────── */
			.price {
				font-family: var(--font-display);
				font-weight: 300;
				font-size: 1.2rem;
				color: var(--text);
			}

			.duration { font-size: 0.8rem; color: var(--muted); }

			.stock-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-size: 0.75rem;
				color: var(--muted);
			}

			.stock-badge::before {
				content: "";
				width: 5px; height: 5px;
				border-radius: 50%;
				background: #48a56a;
				flex-shrink: 0;
			}

			.stock-badge.out::before { background: var(--accent); }

			/* ─── Buttons ─────────────────────────────────────── */
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				padding: 0.65rem 1.3rem;
				border: 1px solid transparent;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				font-weight: 400;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				cursor: pointer;
				transition: all .2s;
				white-space: nowrap;
				text-decoration: none;
			}

			.button:hover { transform: translateY(-1px); }

			.button-primary {
				background: var(--accent);
				color: var(--accent-fg);
				border-color: var(--accent);
			}

			.button-primary:hover { filter: brightness(1.1); }

			.button-dark {
				background: var(--text);
				color: var(--bg);
				border-color: var(--text);
			}

			.button-dark:hover { filter: brightness(0.9); }

			.button-outline {
				border-color: var(--line-2);
				background: transparent;
				color: var(--text);
			}

			.button-outline:hover { border-color: var(--text); }

			.button-ghost {
				border-color: var(--line);
				background: transparent;
				color: var(--fg-dim);
			}

			.button-ghost:hover { border-color: var(--fg-dim); color: var(--text); }

			.button-buy {
				background: var(--accent);
				color: var(--accent-fg);
				border-color: var(--accent);
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				padding: 0.5rem 1rem;
			}

			.button-buy:hover { filter: brightness(1.1); }

			/* ─── Rules ───────────────────────────────────────── */
			.ruled { border: none; border-top: 1px solid var(--line); margin: 0; }

			/* ─── Page hero (inner pages) ─────────────────────── */
			.page-hero {
				background: var(--bg-2);
				color: var(--text);
				padding: 7rem 0 3.5rem;  /* 7rem top to clear fixed nav */
				border-bottom: 1px solid var(--line);
			}

			.page-hero .eyebrow { color: var(--accent); }

			.page-hero h1 {
				font-size: clamp(2.25rem, 5vw, 3rem);
				color: var(--text);
				margin-bottom: 0.6rem;
				font-variation-settings: "SOFT" 100, "opsz" 72;
			}

			.page-hero p { color: var(--fg-dim); max-width: 52ch; font-size: 1rem; }

			/* ─── Post list ───────────────────────────────────── */
			.post-list { list-style: none; display: flex; flex-direction: column; gap: 0; }

			.post-list-item { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
			.post-list-item:first-child { border-top: 1px solid var(--line); }
			.post-list-item a { display: flex; gap: 1.5rem; align-items: flex-start; }
			.post-list-item h2 { font-size: 1.2rem; margin-bottom: 0.25rem; transition: color 0.2s; }
			.post-list-item a:hover h2 { color: var(--accent); }
			.post-list-item p { color: var(--muted); font-size: 0.875rem; line-height: 1.55; }

			.post-tag {
				display: inline-block;
				padding: 0.12rem 0.5rem;
				font-size: 0.68rem;
				font-family: var(--font-mono);
				letter-spacing: 0.1em;
				text-transform: uppercase;
				background: var(--surface);
				color: var(--muted);
				border: 1px solid var(--line);
				margin-right: 0.3rem;
				margin-top: 0.5rem;
			}

			/* ─── Footer ──────────────────────────────────────── */
			footer {
				background: var(--bg);
				border-top: 1px solid var(--line);
			}

			.footer-huge {
				padding: 60px 0;
				display: flex;
				justify-content: center;
				border-bottom: 1px solid var(--line);
			}

			.footer-logo {
				height: clamp(100px, 15vw, 180px);
				width: auto;
				filter: brightness(0) invert(1);
				opacity: 0.15;
			}

			.footer-logo-text {
				font-family: var(--font-display);
				font-size: clamp(3rem, 10vw, 8rem);
				font-weight: 300;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--text);
				opacity: 0.08;
				font-variation-settings: "SOFT" 100, "opsz" 144;
				white-space: nowrap;
			}

			.footer-bar {
				max-width: 1440px;
				margin: 0 auto;
				padding: 28px 44px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.footer-copy {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 1.5px;
				text-transform: uppercase;
				color: var(--muted);
			}

			.footer-links-bar {
				display: flex;
				gap: 28px;
			}

			.footer-links-bar a {
				color: var(--fg-dim);
				text-decoration: none;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 2px;
				text-transform: uppercase;
				transition: color .2s;
			}

			.footer-links-bar a:hover { color: var(--accent); }

			/* ─── Animations ──────────────────────────────────── */
			@keyframes fade-up {
				from { opacity: 0; transform: translateY(12px); }
				to   { opacity: 1; transform: translateY(0); }
			}

			.animate-up { animation: fade-up 0.45s ease both; }

			/* ─── Responsive ──────────────────────────────────── */
			@media (max-width: 1000px) {
				.grid-3 { grid-template-columns: repeat(2, 1fr); }
				.grid-4 { grid-template-columns: repeat(2, 1fr); }
				.ed-nav-links { display: none; }
				.ed-nav-inner { grid-template-columns: auto auto; }
			}

			@media (max-width: 700px) {
				.grid-3, .grid-2, .grid-4 { grid-template-columns: 1fr; }
				.ed-shell { padding: 0 20px; }
				.section-header { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
				.footer-bar { flex-direction: column; align-items: flex-start; }
			}
		</style>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="ed-nav" id="ed-nav">
			<div class="ed-nav-inner">
				<a href="/" class="ed-logo" aria-label={siteTitle}>
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: <img src="/logo.svg" alt={siteTitle} onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
					}
					<span class="ed-logo-text" style="display:none">{siteTitle}</span>
				</a>
				<nav class="ed-nav-links" aria-label="Primary">
					{menu?.items.map((item) => (
						<a href={item.url} target={item.target}>{item.label}</a>
					))}
				</nav>
				<div class="ed-nav-right">
					<LiveSearch placeholder="Search" collections={["posts", "pages", "services", "products"]} />
					<a href="/shop/checkout" class="nav-cart" aria-label="Cart">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
							<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
						</svg>
						<span class="cart-count" id="cart-count" data-count="0">0</span>
					</a>
					<a href="#book" class="nav-book">Book a chair</a>
				</div>
			</div>
		</header>

		<main>
			{fullWidth
				? <slot />
				: <div class="site-shell" style="padding-top:7rem;padding-bottom:4rem"><slot /></div>
			}
		</main>

		<footer>
			<div class="footer-huge">
				<img src="/logo.svg" alt="" class="footer-logo" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
				<span class="footer-logo-text" style="display:none">{siteTitle}</span>
			</div>
			<div class="footer-bar">
				<p class="footer-copy">© {year} {siteTitle} · Annandale NSW 2038</p>
				<div class="footer-links-bar">
					<a href="https://www.instagram.com/dapper_blokes_2038" target="_blank" rel="noopener">Instagram</a>
					<a href="/shop">Shop</a>
					<a href="#book">Book</a>
					<a href="/contact">Contact</a>
					<WidgetArea name="footer" />
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Nav scroll effect
			const nav = document.getElementById('ed-nav');
			if (nav) {
				const onScroll = () => {
					nav.classList.toggle('is-scrolled', window.scrollY > 40);
				};
				window.addEventListener('scroll', onScroll, { passive: true });
				onScroll();
			}

			// Cart counter from localStorage
			function updateCartCount() {
				try {
					const cart = JSON.parse(localStorage.getItem('db_cart') || '[]');
					const count = cart.reduce((n: number, item: {qty: number}) => n + (item.qty || 1), 0);
					const el = document.getElementById('cart-count');
					if (el) {
						el.textContent = String(count);
						el.dataset.count = String(count);
					}
				} catch {}
			}
			updateCartCount();
			window.addEventListener('db-cart-updated', updateCartCount);
		</script>
	</body>
</html>
