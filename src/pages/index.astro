---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: services } = await getEmDashCollection("services", { orderBy: { title: "asc" } });
const { entries: products, cacheHint } = await getEmDashCollection("products", { orderBy: { title: "asc" } });
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
Astro.cache.set(cacheHint);

const toCurrency = (cents: number | null | undefined) =>
	new Intl.NumberFormat("en-AU", { style: "currency", currency: "AUD" }).format((cents ?? 0) / 100);

// Static data from the design (used when CMS data is empty)
const SERVICES = [
	{ id: 'cut',   name: "The Cut",       duration: "45 min", price: 55, blurb: "Scissor or clipper, your way. Hot towel finish." },
	{ id: 'skin',  name: "Skin Fade",     duration: "55 min", price: 65, blurb: "Precision taper, no lines left behind." },
	{ id: 'beard', name: "Beard Sculpt",  duration: "30 min", price: 40, blurb: "Shape, line-up, hot towel, beard oil." },
	{ id: 'combo', name: "Cut + Beard",   duration: "75 min", price: 90, blurb: "The full reset. Cut, beard, towel, done." },
	{ id: 'shave', name: "Straight Razor",duration: "45 min", price: 60, blurb: "Old-school wet shave. Badger brush and all." },
	{ id: 'dad',   name: "Father & Son",  duration: "75 min", price: 85, blurb: "Two chairs, side by side. Make it a tradition." },
];

const BARBERS = [
	{ id: 'amin',  name: "Amin",  role: "Owner / Master Barber", years: 14, specialty: "Scissor work & classic cuts",
	  img: "https://images.unsplash.com/photo-1618077360395-f3068be8e001?w=600&h=750&fit=crop&crop=faces&q=85" },
	{ id: 'jules', name: "Jules", role: "Senior Barber",         years: 9,  specialty: "Skin fades & beard sculpting",
	  img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=750&fit=crop&crop=faces&q=85" },
	{ id: 'theo',  name: "Theo",  role: "Barber",                years: 5,  specialty: "Textured crops & kids cuts",
	  img: "https://images.unsplash.com/photo-1531256456869-ce942a665e80?w=600&h=750&fit=crop&crop=faces&q=85" },
];

const IG_POSTS = [
	{ id: 1, caption: "Wednesday walk-ins welcome. Chair 2 open all arvo.", tag: "#skinfade",  likes: 184,
	  img: "https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=700&h=700&fit=crop&q=85" },
	{ id: 2, caption: "Father & son Saturdays — book the 11am slot before it's gone.", tag: "#dapperboys", likes: 312,
	  img: "https://images.unsplash.com/photo-1621605815971-fbc98d665033?w=500&h=500&fit=crop&q=85" },
	{ id: 3, caption: "Straight razor, hot towel, single malt. Friday evenings only.", tag: "#wetshave", likes: 276,
	  img: "https://images.unsplash.com/photo-1585747860715-2ba37e788b70?w=500&h=500&fit=crop&q=85" },
	{ id: 4, caption: "New in: Layrite pomade restocked. Grab one on the way out.", tag: "#product", likes: 98,
	  img: "https://images.unsplash.com/photo-1634449571010-02389ed0f9b0?w=500&h=500&fit=crop&q=85" },
	{ id: 5, caption: "Amin back from Milan — new scissor technique, same old stories.", tag: "#thecut", likes: 421,
	  img: "https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=500&h=700&fit=crop&q=85" },
	{ id: 6, caption: "The quiet hour: 2pm Wednesdays. Coffee on us.", tag: "#annandale", likes: 157,
	  img: "https://images.unsplash.com/photo-1604654894610-df63bc536371?w=700&h=500&fit=crop&q=85" },
];

const TESTIMONIALS = [
	{ quote: "Best cut I've had in a decade. Amin actually listens.", who: "James K.", meta: "Regular since 2022" },
	{ quote: "Feels like a proper barbershop, not a salon pretending to be one.", who: "Tom H.", meta: "Google review · 5★" },
	{ quote: "Took my dad for his 70th. He's been three times since on his own.", who: "Sarah L.", meta: "Google review · 5★" },
];

const GIFT_AMOUNTS = [50, 90, 150, 250];

const HOURS = [
	["Mon — Tue", "Closed"],
	["Wednesday", "9:00 — 6:00"],
	["Thursday",  "9:00 — 8:00"],
	["Friday",    "9:00 — 6:00"],
	["Saturday",  "8:00 — 4:00"],
	["Sunday",    "9:00 — 2:00"],
];

// Use CMS services if available, otherwise use static data
const displayServices = services.length > 0
	? services.slice(0, 6).map(s => ({
		id: s.id,
		name: s.data.title,
		duration: s.data.duration ?? "45 min",
		price: (s.data.price_cents ?? 0) / 100,
		blurb: s.data.description ?? "",
	  }))
	: SERVICES;

// Use CMS products if available (for shop section)
const displayProducts = products.length > 0
	? products.slice(0, 4).map(p => ({
		id: p.id,
		name: p.data.title,
		kind: p.data.description ?? "Premium grooming",
		price: (p.data.price_cents ?? 0) / 100,
		img: p.data.featured_image,
	  }))
	: null;
---

<Base title={siteTitle} description={siteTagline} fullWidth>

<!-- ═══ HERO ═══════════════════════════════════════════════════════════════ -->
<section class="ed-hero" id="top">
	<div class="hero-inner ed-shell">
		<div class="hero-meta">
			<span class="ed-mono">Est. 2025 · Annandale 2038</span>
			<span class="ed-mono">Chapter ○ 01</span>
		</div>

		<div class="hero-grid">
			<div class="hero-type">
				<h1 class="hero-display">
					<span class="display-line">A proper</span>
					<span class="display-line display-italic">cut,</span>
					<span class="display-line">an honest</span>
					<span class="display-line display-italic">chair.</span>
				</h1>
				<p class="hero-lede">
					Dapper Blokes is a six-chair barbershop at 45 Booth Street, Annandale.
					Classic techniques, hot towels, single malts on Fridays.
					Walk-ins when the bell's on — otherwise, book below.
				</p>
				<div class="hero-actions">
					<a href="#book" class="hero-btn-primary">
						Book a chair <span aria-hidden>→</span>
					</a>
					<a href="#services" class="hero-link-underline">See what we do</a>
				</div>
			</div>
			<div class="hero-img-wrap">
				<img
					src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=900&h=1100&fit=crop&crop=entropy&q=90"
					alt="Barber at work in the chair"
					class="hero-img"
					fetchpriority="high"
					loading="eager"
				/>
				<div class="hero-img-caption">
					<span class="ed-mono">Fig. 01</span>
					<span>Amin, chair two. Scissor-over-comb.</span>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ═══ MARQUEE ════════════════════════════════════════════════════════════ -->
<div class="marquee-band" aria-hidden="true">
	<div class="marquee-track">
		{["Scissor & clipper", "Skin fades", "Beard sculpt", "Straight razor", "Father & son", "Hot towel ritual", "Single malt Fridays", "Walk-ins welcome",
		  "Scissor & clipper", "Skin fades", "Beard sculpt", "Straight razor", "Father & son", "Hot towel ritual", "Single malt Fridays", "Walk-ins welcome",
		  "Scissor & clipper", "Skin fades", "Beard sculpt", "Straight razor", "Father & son", "Hot towel ritual", "Single malt Fridays", "Walk-ins welcome"].map((t, i) => (
			<span class="marquee-item">
				<span>{t}</span>
				<span class="marquee-dot">◆</span>
			</span>
		))}
	</div>
</div>

<!-- ═══ SERVICES ════════════════════════════════════════════════════════════ -->
<section class="ed-section" id="services">
	<div class="ed-section-head">
		<span class="ed-mono">№ 02 — Services</span>
		<h2 class="ed-h2">
			Everything you'd expect<br />
			<span class="ed-display-italic">from a proper barbershop.</span>
		</h2>
	</div>

	<ol class="svc-list">
		{displayServices.map((s, i) => (
			<li class="svc-row" data-svc>
				<span class="svc-num ed-mono">0{i + 1}</span>
				<span class="svc-name">{s.name}</span>
				<span class="svc-dur ed-mono">{s.duration}</span>
				<span class="svc-blurb">{s.blurb}</span>
				<span class="svc-price">${s.price}</span>
			</li>
		))}
	</ol>
	<p class="svc-note ed-mono">All services include a complimentary beverage. Cash or card, no surcharge.</p>
</section>

<!-- ═══ TEAM ════════════════════════════════════════════════════════════════ -->
<section class="ed-section" id="team">
	<div class="ed-section-head">
		<span class="ed-mono">№ 03 — The Chairs</span>
		<h2 class="ed-h2">
			Three barbers.<br />
			<span class="ed-display-italic">Twenty-eight years between them.</span>
		</h2>
	</div>

	<div class="team-grid">
		{BARBERS.map((b, i) => (
			<article class="team-card">
				<div class="team-img-wrap">
					<img src={b.img} alt={b.name} class="team-img" loading="lazy" />
					<span class="team-num ed-mono">0{i + 1}</span>
				</div>
				<div class="team-meta">
					<h3 class="team-name">{b.name}</h3>
					<div class="ed-mono">{b.role} · {b.years} years</div>
					<p class="team-spec">{b.specialty}</p>
				</div>
			</article>
		))}
	</div>
</section>

<!-- ═══ INSTAGRAM / JOURNAL ═════════════════════════════════════════════════ -->
<section class="ed-section ig-section" id="feed">
	<div class="ed-section-head" style="flex-direction:row;justify-content:space-between;align-items:flex-end">
		<div>
			<span class="ed-mono">№ 04 — Journal</span>
			<h2 class="ed-h2" style="margin-top:24px">
				From the feed<br />
				<span class="ed-display-italic">@dapper_blokes_2038</span>
			</h2>
		</div>
		<a href="https://www.instagram.com/dapper_blokes_2038" target="_blank" rel="noreferrer" class="ig-follow-link">
			Follow on Instagram →
		</a>
	</div>

	<div class="ig-grid">
		{IG_POSTS.map((post, i) => (
			<figure class={`ig-item ig-item-${i}`}>
				<div class="ig-img-wrap">
					<img src={post.img} alt={post.caption} class="ig-img" loading="lazy" />
				</div>
				<figcaption class="ig-cap">
					<span class="ed-mono ig-tag">{post.tag}</span>
					<p class="ig-caption">"{post.caption}"</p>
					<span class="ed-mono ig-likes">♥ {post.likes}</span>
				</figcaption>
			</figure>
		))}
	</div>
</section>

<!-- ═══ BOOKING ══════════════════════════════════════════════════════════════ -->
<section class="ed-section book-section" id="book">
	<div class="ed-section-head">
		<span class="ed-mono">№ 05 — Reservations</span>
		<h2 class="ed-h2">
			Claim a chair<br />
			<span class="ed-display-italic">in four steps.</span>
		</h2>
	</div>

	<div class="bk-root" id="booking-flow">
		<!-- Progress -->
		<div class="bk-progress">
			<div class="bk-step is-active" data-step="0">
				<span class="bk-step-num">01</span>
				<span class="bk-step-label">Service</span>
			</div>
			<div class="bk-step" data-step="1">
				<span class="bk-step-num">02</span>
				<span class="bk-step-label">Barber</span>
			</div>
			<div class="bk-step" data-step="2">
				<span class="bk-step-num">03</span>
				<span class="bk-step-label">Time</span>
			</div>
			<div class="bk-step" data-step="3">
				<span class="bk-step-num">04</span>
				<span class="bk-step-label">Details</span>
			</div>
		</div>

		<!-- Step 0: Service -->
		<div class="bk-panel" id="bk-panel-0">
			<div class="bk-grid bk-grid-services">
				{SERVICES.map(s => (
					<button class="bk-card" data-pick="service" data-value={s.id} data-price={s.price}>
						<div class="bk-card-head">
							<span class="bk-card-title">{s.name}</span>
							<span class="bk-card-price">${s.price}</span>
						</div>
						<div class="bk-card-meta">{s.duration}</div>
						<div class="bk-card-blurb">{s.blurb}</div>
					</button>
				))}
			</div>
		</div>

		<!-- Step 1: Barber -->
		<div class="bk-panel" id="bk-panel-1" hidden>
			<div class="bk-grid bk-grid-barbers">
				<button class="bk-card bk-card-any" data-pick="barber" data-value="any">
					<div class="bk-card-title">No preference</div>
					<div class="bk-card-meta">First available chair</div>
				</button>
				{BARBERS.map(b => (
					<button class="bk-card" data-pick="barber" data-value={b.id}>
						<div class="bk-card-avatar">
							<img src={b.img} alt={b.name} style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
						</div>
						<div class="bk-card-title">{b.name}</div>
						<div class="bk-card-meta">{b.role}</div>
						<div class="bk-card-blurb">{b.specialty}</div>
					</button>
				))}
			</div>
		</div>

		<!-- Step 2: Time -->
		<div class="bk-panel" id="bk-panel-2" hidden>
			<span class="bk-label">Pick a day</span>
			<div class="bk-days" id="bk-days"></div>
			<div id="bk-times-wrap" hidden>
				<span class="bk-label" style="margin-top:28px;display:block">Pick a time</span>
				<div class="bk-times" id="bk-times"></div>
			</div>
		</div>

		<!-- Step 3: Details -->
		<div class="bk-panel" id="bk-panel-3" hidden>
			<div class="bk-details">
				<label class="bk-field">
					<span class="bk-label">Your name</span>
					<input type="text" id="bk-name" placeholder="First and last" autocomplete="name" />
				</label>
				<label class="bk-field">
					<span class="bk-label">Mobile</span>
					<input type="tel" id="bk-phone" placeholder="04xx xxx xxx" autocomplete="tel" />
				</label>
				<div class="bk-summary" id="bk-summary"></div>
			</div>
		</div>

		<!-- Confirm screen -->
		<div class="bk-panel bk-confirm" id="bk-panel-done" hidden>
			<div class="bk-confirm-mark">✓</div>
			<div class="bk-confirm-eyebrow">Booking held</div>
			<h3 class="bk-confirm-title" id="bk-confirm-title">See you soon.</h3>
			<p class="bk-confirm-body">We've texted a confirmation. If plans change, reply to that message.</p>
			<button class="bk-btn bk-btn-ghost" id="bk-reset">Book another</button>
		</div>

		<div class="bk-nav" id="bk-nav">
			<button class="bk-btn bk-btn-ghost" id="bk-back" disabled>Back</button>
			<button class="bk-btn bk-btn-primary" id="bk-next" disabled>Continue <span>→</span></button>
		</div>
	</div>
</section>

<!-- ═══ TESTIMONIALS ════════════════════════════════════════════════════════ -->
<section class="ed-section quotes-section">
	<div class="quote-mark" aria-hidden="true">"</div>
	<div class="quote-stack" id="quote-stack">
		{TESTIMONIALS.map((t, i) => (
			<blockquote class={`quote ${i === 0 ? 'is-active' : ''}`} data-quote={i} aria-hidden={i !== 0}>
				<p class="quote-text">{t.quote}</p>
				<cite class="quote-cite">
					<span>{t.who}</span>
					<span class="ed-mono">{t.meta}</span>
				</cite>
			</blockquote>
		))}
	</div>
	<div class="quote-dots">
		{TESTIMONIALS.map((_, i) => (
			<button class={`quote-dot ${i === 0 ? 'is-active' : ''}`} data-dot={i} aria-label={`Testimonial ${i + 1}`} />
		))}
	</div>
</section>

<!-- ═══ GIFT CARDS ═══════════════════════════════════════════════════════════ -->
<section class="ed-section gift-section">
	<div class="gift-grid">
		<div class="gift-text">
			<span class="ed-mono">№ 06 — Gift Cards</span>
			<h2 class="ed-h2" style="margin-top:24px">
				The well-judged<br />
				<span class="ed-display-italic">present.</span>
			</h2>
			<p class="gift-lede">
				For dads, brothers, groomsmen, or the mate who still cuts his own fringe.
				Redeemable for any service. Never expires.
			</p>
			<div class="gift-amounts" id="gift-amounts">
				{GIFT_AMOUNTS.map(a => (
					<button class={`gift-amount ${a === 90 ? 'is-picked' : ''}`} data-amount={a}>${a}</button>
				))}
			</div>
			<button class="gift-buy-btn" id="gift-buy-btn">Send a $90 card <span>→</span></button>
		</div>
		<div class="gift-card-visual" id="gift-card-visual">
			<div class="gift-card-inner">
				<div class="gift-card-top">
					<img src="/logo.svg" alt="" class="gift-card-logo" />
					<span class="ed-mono" style="opacity:0.5">Gift Card</span>
				</div>
				<div class="gift-card-amount" id="gift-card-amount">$90</div>
				<div class="gift-card-foot">
					<span class="ed-mono" style="opacity:0.5">Redeemable in-shop or online</span>
					<span class="ed-mono" id="gift-card-num" style="opacity:0.4">№ DB-000630</span>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ═══ SHOP ════════════════════════════════════════════════════════════════ -->
<section class="ed-section shop-section" id="shop">
	<div class="ed-section-head" style="flex-direction:row;justify-content:space-between;align-items:flex-end">
		<div>
			<span class="ed-mono">№ 07 — The Shelf</span>
			<h2 class="ed-h2" style="margin-top:24px">
				What we use,<br />
				<span class="ed-display-italic">what you take home.</span>
			</h2>
		</div>
		<a href="/shop" class="ig-follow-link">See everything →</a>
	</div>

	<div class="shop-grid">
		{displayProducts
			? displayProducts.map(p => (
				<a href={`/products/${p.id}`} class="shop-card">
					<div class="shop-img-wrap">
						{p.img
							? <Image image={p.img} class="shop-img" />
							: <div class="shop-img-placeholder"><span>{p.name.charAt(0)}</span></div>
						}
					</div>
					<div class="shop-meta">
						<div>
							<h3 class="shop-name">{p.name}</h3>
							<div class="ed-mono">{p.kind}</div>
						</div>
						<span class="shop-price">{toCurrency(p.price * 100)}</span>
					</div>
				</a>
			))
			: [
				{ name: "Layrite Original", kind: "Pomade · 120g", price: 32, img: "https://images.unsplash.com/photo-1585421514738-01798e348b17?w=400&h=400&fit=crop&q=85" },
				{ name: "Dapper No.3", kind: "Beard Oil · 30ml", price: 28, img: "https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=400&h=400&fit=crop&q=85" },
				{ name: "Badger Brush", kind: "Shaving · Silvertip", price: 85, img: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=400&h=400&fit=crop&q=85" },
				{ name: "Hot Towel Set", kind: "At-home ritual", price: 45, img: "https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?w=400&h=400&fit=crop&q=85" },
			].map(p => (
				<a href="/shop" class="shop-card">
					<div class="shop-img-wrap">
						<img src={p.img} alt={p.name} class="shop-img" loading="lazy" />
					</div>
					<div class="shop-meta">
						<div>
							<h3 class="shop-name">{p.name}</h3>
							<div class="ed-mono">{p.kind}</div>
						</div>
						<span class="shop-price">${p.price}</span>
					</div>
				</a>
			))
		}
	</div>
</section>

<!-- ═══ LOCATION ════════════════════════════════════════════════════════════ -->
<section class="ed-section visit-section" id="visit">
	<div class="visit-grid">
		<div class="visit-text">
			<span class="ed-mono">№ 08 — Visit</span>
			<h2 class="ed-h2" style="margin-top:24px">
				Booth Street,<br />
				<span class="ed-display-italic">Annandale.</span>
			</h2>
			<div class="visit-info">
				<div>
					<div class="ed-mono">Address</div>
					<p class="visit-detail">45 Booth St, Annandale NSW 2038</p>
				</div>
				<div>
					<div class="ed-mono">Phone</div>
					<p class="visit-detail">(02) 9555 0210</p>
				</div>
				<div>
					<div class="ed-mono">Email</div>
					<p class="visit-detail">hello@dapperblokes.hair</p>
				</div>
			</div>
		</div>
		<div class="visit-hours">
			<div class="ed-mono" style="margin-bottom:16px">Hours</div>
			<ul class="hours-list">
				{HOURS.map(([day, hrs]) => (
					<li class="hours-row">
						<span>{day}</span>
						<span class={hrs === "Closed" ? "hours-closed" : ""}>{hrs}</span>
					</li>
				))}
			</ul>
		</div>
		<div class="visit-map">
			<iframe
