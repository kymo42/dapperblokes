	aspect-ratio: 16/9;
	grid-column: 2;
	overflow: hidden;
	filter: grayscale(1) contrast(1.1) brightness(0.5);
}

/* ─── Responsive ──────────────────────────────────────────── */
@media (max-width: 960px) {
	.hero-grid { grid-template-columns: 1fr; gap: 48px; }
	.hero-img-wrap { aspect-ratio: 4/3; }
	.svc-row { grid-template-columns: 1fr auto; gap: 8px; }
	.svc-num, .svc-dur, .svc-blurb { display: none; }
	.team-grid { grid-template-columns: 1fr; }
	.shop-grid { grid-template-columns: 1fr 1fr; }
	.visit-grid { grid-template-columns: 1fr; }
	.visit-text { grid-row: auto; }
	.visit-map { grid-column: auto; aspect-ratio: 4/3; }
	.gift-grid { grid-template-columns: 1fr; gap: 48px; }
	.ig-grid { grid-template-columns: 1fr; grid-auto-rows: auto; }
	.ig-item { grid-column: auto !important; grid-row: auto !important; }
	.ig-img-wrap { aspect-ratio: 1; }
	.bk-grid-services, .bk-grid-barbers { grid-template-columns: repeat(2, 1fr); }
	.bk-days { grid-template-columns: repeat(5, 1fr); }
	.bk-times { grid-template-columns: repeat(3, 1fr); }
	.bk-details { grid-template-columns: 1fr; }
	.bk-confirm-title { font-size: 28px; }
	.ed-section { padding: 80px 24px; }
}

@media (max-width: 600px) {
	.hero-display { font-size: clamp(56px, 14vw, 80px); }
	.ed-hero { padding-top: 70px; }
	.marquee-item { font-size: 28px; }
	.shop-grid { grid-template-columns: 1fr; }
	.hero-inner { padding: 20px; }
	.bk-progress { grid-template-columns: repeat(2, 1fr); }
	.bk-step-label { font-size: 14px; }
	.quote-stack { min-height: 280px; }
}
</style>

<script>
// ─── Booking flow ────────────────────────────────────────────────────────────
const BK = {
	step: 0,
	picked: { service: null as string|null, barber: null as string|null, date: null as string|null, time: null as string|null },
	name: '',
	phone: '',
};

const SERVICES_DATA = [
	{ id: 'cut',   name: "The Cut",        duration: "45 min", price: 55 },
	{ id: 'skin',  name: "Skin Fade",      duration: "55 min", price: 65 },
	{ id: 'beard', name: "Beard Sculpt",   duration: "30 min", price: 40 },
	{ id: 'combo', name: "Cut + Beard",    duration: "75 min", price: 90 },
	{ id: 'shave', name: "Straight Razor", duration: "45 min", price: 60 },
	{ id: 'dad',   name: "Father & Son",   duration: "75 min", price: 85 },
];

const BARBERS_DATA = [
	{ id: 'amin',  name: "Amin" },
	{ id: 'jules', name: "Jules" },
	{ id: 'theo',  name: "Theo" },
];

const TAKEN_TIMES = new Set(['10:30', '12:00', '3:00']);
const TIMES = ['9:00','9:45','10:30','11:15','12:00','1:30','2:15','3:00','3:45','4:30'];

function buildDays() {
	const days = [];
	const start = new Date();
	start.setDate(start.getDate() + 1);
	for (let i = 0; i < 10; i++) {
		const d = new Date(start);
		d.setDate(start.getDate() + i);
		days.push({
			iso: d.toISOString().slice(0, 10),
			dow: d.toLocaleDateString('en-AU', { weekday: 'short' }).toUpperCase(),
			day: d.getDate(),
			mon: d.toLocaleDateString('en-AU', { month: 'short' }).toUpperCase(),
		});
	}
	return days;
}

function canAdvance() {
	if (BK.step === 0) return !!BK.picked.service;
	if (BK.step === 1) return !!BK.picked.barber;
	if (BK.step === 2) return !!BK.picked.date && !!BK.picked.time;
	if (BK.step === 3) return BK.name.trim().length > 1 && BK.phone.replace(/\D/g,'').length >= 8;
	return false;
}

function updateProgress() {
	document.querySelectorAll('.bk-step').forEach((el, i) => {
		el.classList.toggle('is-active', i === BK.step);
		el.classList.toggle('is-done', i < BK.step);
	});
}

function showPanel(step: number) {
	document.querySelectorAll('.bk-panel').forEach(p => p.setAttribute('hidden', ''));
	const panel = document.getElementById(`bk-panel-${step}`);
	if (panel) panel.removeAttribute('hidden');
}

function updateNav() {
	const back = document.getElementById('bk-back') as HTMLButtonElement;
	const next = document.getElementById('bk-next') as HTMLButtonElement;
	if (!back || !next) return;
	back.disabled = BK.step === 0;
	next.disabled = !canAdvance();
	next.innerHTML = BK.step === 3 ? 'Confirm booking <span>→</span>' : 'Continue <span>→</span>';
}

function renderDays() {
	const wrap = document.getElementById('bk-days');
	if (!wrap) return;
	const days = buildDays();
	wrap.innerHTML = days.map(d => `
		<button class="bk-day${BK.picked.date === d.iso ? ' is-picked' : ''}" data-date="${d.iso}">
			<span class="bk-day-dow">${d.dow}</span>
			<span class="bk-day-num">${d.day}</span>
			<span class="bk-day-mon">${d.mon}</span>
		</button>
	`).join('');
	wrap.querySelectorAll('.bk-day').forEach(btn => {
		btn.addEventListener('click', () => {
			BK.picked.date = (btn as HTMLElement).dataset.date ?? null;
			BK.picked.time = null;
			renderDays();
			renderTimes();
			updateNav();
		});
	});
}

function renderTimes() {
	const timesWrap = document.getElementById('bk-times-wrap');
	const timesEl = document.getElementById('bk-times');
	if (!timesWrap || !timesEl) return;
	if (!BK.picked.date) { timesWrap.setAttribute('hidden', ''); return; }
	timesWrap.removeAttribute('hidden');
	timesEl.innerHTML = TIMES.map(t => {
		const taken = TAKEN_TIMES.has(t);
		return `<button class="bk-time-btn${BK.picked.time === t ? ' is-picked' : ''}${taken ? ' is-taken' : ''}" data-time="${t}" ${taken ? 'disabled' : ''}>${t}</button>`;
	}).join('');
	timesEl.querySelectorAll('.bk-time-btn:not(:disabled)').forEach(btn => {
		btn.addEventListener('click', () => {
			BK.picked.time = (btn as HTMLElement).dataset.time ?? null;
			renderTimes();
			updateNav();
		});
	});
}

function renderSummary() {
	const el = document.getElementById('bk-summary');
	if (!el) return;
	const svc = SERVICES_DATA.find(s => s.id === BK.picked.service);
	const barber = BK.picked.barber === 'any' ? 'First available' : BARBERS_DATA.find(b => b.id === BK.picked.barber)?.name;
	const dateStr = BK.picked.date ? new Date(BK.picked.date).toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' }) : '';
	el.innerHTML = `
		<div class="bk-summary-line"><span>Service</span><strong>${svc?.name ?? ''}</strong></div>
		<div class="bk-summary-line"><span>Barber</span><strong>${barber ?? ''}</strong></div>
		<div class="bk-summary-line"><span>When</span><strong>${dateStr} · ${BK.picked.time ?? ''}</strong></div>
		<div class="bk-summary-line bk-summary-total"><span>Total</span><strong>$${svc?.price ?? ''}</strong></div>
	`;
}

function showConfirm() {
	document.getElementById('bk-nav')?.setAttribute('hidden', '');
	document.getElementById('bk-panel-3')?.setAttribute('hidden', '');
	const done = document.getElementById('bk-panel-done');
	if (done) done.removeAttribute('hidden');
	const title = document.getElementById('bk-confirm-title');
	if (title && BK.picked.date) {
		const dateStr = new Date(BK.picked.date).toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' });
		title.textContent = `See you ${dateStr}, ${BK.picked.time}.`;
	}
	// Progress
	document.querySelectorAll('.bk-step').forEach(el => el.classList.add('is-done'));
}

function resetBooking() {
	BK.step = 0;
	BK.picked = { service: null, barber: null, date: null, time: null };
	BK.name = '';
	BK.phone = '';
	// Unmark all service/barber cards
	document.querySelectorAll('.bk-card').forEach(c => c.classList.remove('is-picked'));
	document.getElementById('bk-nav')?.removeAttribute('hidden');
	showPanel(0);
	updateProgress();
	updateNav();
}

// Init
document.addEventListener('DOMContentLoaded', () => {
	renderDays();
	updateNav();

	// Card picks (service + barber steps)
	document.querySelectorAll('[data-pick]').forEach(btn => {
		btn.addEventListener('click', () => {
			const type = (btn as HTMLElement).dataset.pick!;
			const val = (btn as HTMLElement).dataset.value!;
			BK.picked[type as 'service'|'barber'] = val;
			// Update card highlight
			btn.closest('.bk-grid')?.querySelectorAll('.bk-card').forEach(c => c.classList.remove('is-picked'));
			btn.classList.add('is-picked');
			updateNav();
		});
	});

	// Name/phone inputs
	document.getElementById('bk-name')?.addEventListener('input', e => {
		BK.name = (e.target as HTMLInputElement).value;
		updateNav();
	});
	document.getElementById('bk-phone')?.addEventListener('input', e => {
		BK.phone = (e.target as HTMLInputElement).value;
		updateNav();
	});

	// Next
	document.getElementById('bk-next')?.addEventListener('click', () => {
		if (!canAdvance()) return;
		if (BK.step === 3) { showConfirm(); return; }
		BK.step++;
		updateProgress();
		showPanel(BK.step);
		if (BK.step === 3) renderSummary();
		updateNav();
	});

	// Back
	document.getElementById('bk-back')?.addEventListener('click', () => {
		if (BK.step === 0) return;
		BK.step--;
		updateProgress();
		showPanel(BK.step);
		updateNav();
	});

	// Prog step click (go back)
	document.querySelectorAll('.bk-step').forEach((el, i) => {
		el.addEventListener('click', () => {
			if (i < BK.step) {
				BK.step = i;
				updateProgress();
				showPanel(i);
				updateNav();
			}
		});
	});

	// Reset
	document.getElementById('bk-reset')?.addEventListener('click', resetBooking);
});

// ─── Testimonials carousel ──────────────────────────────────────────────────
let quoteIdx = 0;
const quotes = document.querySelectorAll('.quote');
const dots = document.querySelectorAll('.quote-dot');

function showQuote(i: number) {
	quotes.forEach((q, j) => {
		q.classList.toggle('is-active', j === i);
		q.setAttribute('aria-hidden', j !== i ? 'true' : 'false');
	});
	dots.forEach((d, j) => d.classList.toggle('is-active', j === i));
}

dots.forEach((d, i) => {
	d.addEventListener('click', () => { quoteIdx = i; showQuote(i); });
});

setInterval(() => {
	quoteIdx = (quoteIdx + 1) % quotes.length;
	showQuote(quoteIdx);
}, 6000);

// ─── Gift card amount selector ──────────────────────────────────────────────
let giftAmount = 90;

document.querySelectorAll('.gift-amount').forEach(btn => {
	btn.addEventListener('click', () => {
		giftAmount = parseInt((btn as HTMLElement).dataset.amount ?? '90');
		document.querySelectorAll('.gift-amount').forEach(b => b.classList.remove('is-picked'));
		btn.classList.add('is-picked');
		const amountEl = document.getElementById('gift-card-amount');
		if (amountEl) amountEl.textContent = `$${giftAmount}`;
		const numEl = document.getElementById('gift-card-num');
		if (numEl) numEl.textContent = `№ DB-${String(giftAmount * 7).padStart(6, '0')}`;
		const buyBtn = document.getElementById('gift-buy-btn');
		if (buyBtn) buyBtn.innerHTML = `Send a $${giftAmount} card <span>→</span>`;
	});
});
</script>
