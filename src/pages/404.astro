---
import Base from "../layouts/Base.astro";
---

<Base title="Not Found">
	<div class="not-found">
		<p class="eyebrow">404</p>
		<h1>Page not found.</h1>
		<p>We couldn't find what you're looking for — it may have moved or never existed.</p>
		<a href="/" class="button button-ghost" style="margin-top:1.5rem;">Back to Home</a>
	</div>
</Base>

<style>
	.not-found {
		padding: 5rem 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.not-found h1 {
		font-size: clamp(2rem, 6vw, 3.5rem);
		margin: 0.5rem 0 0.75rem;
	}

	.not-found p:not(.eyebrow) {
		color: var(--muted);
		font-size: 1rem;
		max-width: 44ch;
	}
</style>
