---
export const prerender = false;

import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) return Astro.redirect("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);

if (!product) return Astro.redirect("/404");

Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/products/${slug}`,
});

const toCurrency = (cents: number | null | undefined) =>
	new Intl.NumberFormat("en-AU", { style: "currency", currency: "AUD" }).format((cents ?? 0) / 100);

const price = product.data.price_cents ?? 0;
const inStock = product.data.in_stock ?? false;
const checkoutUrl = `/checkout?id=${product.id}&title=${encodeURIComponent(product.data.title)}&price=${price}`;
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "products", id: product.data.id, slug }}
>
	<div class="product-detail-wrap">

		<!-- Image panel -->
		<div class="product-img-panel">
			{product.data.featured_image
				? <div class="product-img-main"><Image image={product.data.featured_image} /></div>
				: <div class="product-img-placeholder">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--line)">
							<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
							<line x1="3" y1="6" x2="21" y2="6"/>
							<path d="M16 10a4 4 0 0 1-8 0"/>
						</svg>
						<span>{product.data.title}</span>
					</div>
			}
		</div>

		<!-- Info panel -->
		<div class="product-info-panel">
			<p class="eyebrow">From The Shelf</p>
			<h1 {...product.edit?.title}>{product.data.title}</h1>

			<div class="product-price-row">
				<span class="product-price">{toCurrency(price)}</span>
				<span class={`stock-badge${inStock ? "" : " out"}`}>
					{inStock ? "In stock" : "Out of stock"}
				</span>
			</div>

			{product.data.description && (
				<p class="product-description">{product.data.description}</p>
			)}

			{product.data.details && (
				<div class="product-details-prose">
					<PortableText value={product.data.details} />
				</div>
			)}

			{inStock ? (
				<div class="product-buy-actions">
					<a href={checkoutUrl} class="button button-dark buy-btn">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
						Buy Now — {toCurrency(price)}
					</a>
					<button class="button button-ghost add-cart-btn"
						data-id={product.id}
						data-title={product.data.title}
						data-price={price}
						type="button"
					>
						Add to Cart
					</button>
				</div>
			) : (
				<p class="out-of-stock-msg">This product is currently out of stock. Check back soon or <a href="/contact">contact us</a> to be notified.</p>
			)}

			<div class="product-trust">
				<div class="trust-item">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
					Used in-chair at Dapper Blokes
				</div>
				<div class="trust-item">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
					Secure checkout via Square
				</div>
				<div class="trust-item">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
					Available in-store at 45 Booth St
				</div>
			</div>
		</div>

	</div>

	<!-- Back to shop -->
	<div class="back-bar">
		<a href="/shop" class="back-link">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
			Back to shop
		</a>
	</div>
</Base>

<style>
	.product-detail-wrap {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
		padding: 3.5rem 0 2rem;
	}

	/* Image panel */
	.product-img-panel {}

	.product-img-main {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--line);
	}

	.product-img-main img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		display: block;
	}

	.product-img-placeholder {
		aspect-ratio: 1;
		background: var(--bg-off);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		color: var(--muted);
		font-size: 0.875rem;
	}

	/* Info panel */
	.product-info-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 0.5rem;
	}

	.product-info-panel h1 {
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		line-height: 1.1;
	}

	.product-price-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.product-price {
		font-family: "Fraunces", serif;
		font-size: 1.85rem;
		font-weight: 600;
		color: var(--text);
	}

	.product-description {
		font-size: 1rem;
		color: var(--muted);
		line-height: 1.7;
		padding-top: 0.25rem;
	}

	.product-details-prose {
		font-size: 0.9375rem;
		color: var(--muted);
		line-height: 1.7;
		border-top: 1px solid var(--line);
		padding-top: 1rem;
	}

	.product-details-prose p { margin-bottom: 0.6em; }
	.product-details-prose ul { padding-left: 1.25em; }
	.product-details-prose li { margin-bottom: 0.3em; }

	.product-buy-actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding-top: 0.5rem;
	}

	.buy-btn {
		flex: 1;
		min-width: 180px;
		font-size: 0.9rem;
		padding: 0.8rem 1.4rem;
	}

	.add-cart-btn { flex-shrink: 0; }

	.out-of-stock-msg {
		font-size: 0.9rem;
		color: var(--muted);
		background: var(--bg-off);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 0.9rem 1.1rem;
		line-height: 1.6;
	}

	.out-of-stock-msg a { color: var(--accent); text-decoration: underline; }

	.product-trust {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--line);
	}

	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.trust-item svg { color: var(--accent); flex-shrink: 0; }

	/* Back bar */
	.back-bar {
		padding: 1.5rem 0 3rem;
		border-top: 1px solid var(--line);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.825rem;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.2s;
	}

	.back-link:hover { color: var(--text); }

	@media (max-width: 750px) {
		.product-detail-wrap {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: 2rem 0 1rem;
		}
	}
</style>

<script>
	interface CartItem { id: string; title: string; price: number; qty: number; }

	function getCart(): CartItem[] {
		try { return JSON.parse(localStorage.getItem('db_cart') || '[]'); }
		catch { return []; }
	}

	function saveCart(cart: CartItem[]) {
		localStorage.setItem('db_cart', JSON.stringify(cart));
		window.dispatchEvent(new Event('db-cart-updated'));
	}

	document.querySelector<HTMLButtonElement>('.add-cart-btn')?.addEventListener('click', (e) => {
		const btn = e.currentTarget as HTMLButtonElement;
		const { id, title, price } = btn.dataset;
		if (!id || !title || !price) return;
		const cart = getCart();
		const existing = cart.find(i => i.id === id);
		if (existing) { existing.qty += 1; } else { cart.push({ id, title, price: Number(price), qty: 1 }); }
		saveCart(cart);
		btn.textContent = '✓ Added';
		setTimeout(() => { btn.textContent = 'Add to Cart'; }, 2000);
	});
</script>
