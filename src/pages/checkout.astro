---
export const prerender = false;

import Base from "../layouts/Base.astro";

// Read Square config from Cloudflare env
const env = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const squareAppId = env.SQUARE_APP_ID ?? env.PUBLIC_SQUARE_APP_ID ?? "";
const squareLocationId = env.SQUARE_LOCATION_ID ?? env.PUBLIC_SQUARE_LOCATION_ID ?? "";
const squareEnv = (env.SQUARE_ENVIRONMENT ?? "production") as "sandbox" | "production";
const squareSdkUrl = squareEnv === "sandbox"
	? "https://sandbox.web.squarecdn.com/v1/square.js"
	: "https://web.squarecdn.com/v1/square.js";

// Product from query params (single-product buy-now flow)
const url = Astro.url;
const qId    = url.searchParams.get("id") ?? "";
const qTitle = url.searchParams.get("title") ?? "";
const qPrice = Number(url.searchParams.get("price") ?? "0");

const toCurrency = (cents: number) =>
	new Intl.NumberFormat("en-AU", { style: "currency", currency: "AUD" }).format(cents / 100);
---

<Base title="Checkout — Dapper Blokes Hair">
	<div class="page-hero full-bleed">
		<div class="site-shell">
			<p class="eyebrow">Secure Checkout</p>
			<h1>Complete Your Order</h1>
			<p>Powered by Square — your payment details are encrypted and never stored by us.</p>
		</div>
	</div>

	<section class="page-section">
		<div class="checkout-wrap">

			<!-- Order summary -->
			<div class="order-panel">
				<h2 class="panel-title">Order Summary</h2>

				<div id="order-items">
					{qId && qTitle && qPrice > 0 && (
						<div class="order-item" data-id={qId} data-title={qTitle} data-price={qPrice}>
							<div class="order-item-info">
								<span class="order-item-name">{qTitle}</span>
								<span class="order-item-qty">Qty 1</span>
							</div>
							<span class="order-item-price">{toCurrency(qPrice)}</span>
						</div>
					)}
				</div>

				<div class="cart-items-placeholder" id="cart-items-placeholder" style="display:none">
					<!-- filled by JS from localStorage cart -->
				</div>

				<div class="order-divider"></div>

				<div class="order-total-row">
					<span>Total</span>
					<span class="order-total" id="order-total">{qPrice > 0 ? toCurrency(qPrice) : "$0.00"}</span>
				</div>

				<div class="order-secure-note">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
					256-bit SSL encryption · Powered by Square
				</div>
			</div>

			<!-- Payment form -->
			<div class="payment-panel">
				<h2 class="panel-title">Payment Details</h2>

				{!squareAppId ? (
					<div class="config-warning">
						<p><strong>Square not configured.</strong> Add <code>SQUARE_APP_ID</code>, <code>SQUARE_LOCATION_ID</code>, and <code>SQUARE_ACCESS_TOKEN</code> to your Cloudflare Worker environment variables to enable payments.</p>
						<a href="/shop" class="button button-ghost" style="margin-top:1rem">← Back to Shop</a>
					</div>
				) : (
					<form id="payment-form">
						<div class="field-group">
							<label class="field-label" for="buyer-name">Full Name</label>
							<input id="buyer-name" name="buyer_name" type="text" class="field-input" placeholder="Jane Smith" required />
						</div>
						<div class="field-group">
							<label class="field-label" for="buyer-email">Email Address</label>
							<input id="buyer-email" name="buyer_email" type="email" class="field-input" placeholder="jane@example.com" required />
						</div>

						<div class="field-group">
							<label class="field-label">Card Details</label>
							<div id="card-container" class="card-container"></div>
						</div>

						<div id="payment-error" class="payment-error" role="alert" style="display:none"></div>
						<div id="payment-success" class="payment-success" role="status" style="display:none">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
							Payment successful! Check your email for a receipt.
						</div>

						<button id="pay-btn" class="pay-btn" type="submit" disabled>
							<span id="pay-btn-text">Initialising…</span>
							<span id="pay-spinner" class="pay-spinner" style="display:none"></span>
						</button>

						<p class="pay-disclaimer">By completing your purchase you agree to our terms. Refunds are handled in store.</p>
					</form>
				)}
			</div>

		</div>
	</section>
</Base>

<!-- Square Web Payments SDK -->
{squareAppId && <script is:inline src={squareSdkUrl}></script>}

<script define:vars={{ squareAppId, squareLocationId, qId, qTitle, qPrice }}>
if (squareAppId) {
	// ── Cart helpers ─────────────────────────────────────────
	function getCart() {
		try { return JSON.parse(localStorage.getItem('db_cart') || '[]'); }
		catch { return []; }
	}

	function toCurrency(cents) {
		return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(cents / 100);
	}

	// ── Build order from URL param OR localStorage cart ──────
	let orderItems = [];
	if (qId && qTitle && qPrice > 0) {
		orderItems = [{ id: qId, title: qTitle, price: qPrice, qty: 1 }];
	} else {
		const cart = getCart();
		if (cart.length > 0) {
			orderItems = cart;
			const placeholder = document.getElementById('cart-items-placeholder');
			if (placeholder) {
				placeholder.style.display = 'block';
				placeholder.innerHTML = cart.map(item => `
					<div class="order-item">
						<div class="order-item-info">
							<span class="order-item-name">${item.title}</span>
							<span class="order-item-qty">Qty ${item.qty || 1}</span>
						</div>
						<span class="order-item-price">${toCurrency(item.price * (item.qty || 1))}</span>
					</div>
				`).join('');
			}
		}
	}

	const totalCents = orderItems.reduce((sum, item) => sum + item.price * (item.qty || 1), 0);
	const totalEl = document.getElementById('order-total');
	if (totalEl) totalEl.textContent = toCurrency(totalCents);

	// ── Square payment init ──────────────────────────────────
	async function initSquare() {
		if (!window.Square) {
			console.error('Square SDK failed to load');
			return;
		}

		const payments = window.Square.payments(squareAppId, squareLocationId);
		let card;

		try {
			card = await payments.card({
				style: {
					'.input-container': { borderColor: '#e8dfd2', borderRadius: '3px' },
					'.input-container.is-focus': { borderColor: '#120d08' },
					'.input-container.is-error': { borderColor: '#c0503a' },
					'.message-text': { color: '#7c7268' },
					'.message-icon': { color: '#7c7268' },
					input: { backgroundColor: '#fff', color: '#120d08', fontFamily: '"DM Sans", sans-serif' },
					'input::placeholder': { color: '#a09890' },
				}
			});
			await card.attach('#card-container');
		} catch (e) {
			console.error('Failed to attach Square card element:', e);
			return;
		}

		const payBtn = document.getElementById('pay-btn');
		const payBtnText = document.getElementById('pay-btn-text');
		const paySpinner = document.getElementById('pay-spinner');
		const payError = document.getElementById('payment-error');
		const paySuccess = document.getElementById('payment-success');

		if (payBtn && payBtnText) {
			payBtn.disabled = false;
			payBtnText.textContent = totalCents > 0
				? `Pay ${toCurrency(totalCents)}`
				: 'Pay';
		}

		document.getElementById('payment-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();

			if (!totalCents || totalCents <= 0) {
				if (payError) { payError.textContent = 'No items in order.'; payError.style.display = 'flex'; }
				return;
			}

			// Set loading state
			if (payBtn) payBtn.disabled = true;
			if (payBtnText) payBtnText.textContent = 'Processing…';
			if (paySpinner) paySpinner.style.display = 'block';
			if (payError) payError.style.display = 'none';

			try {
				const tokenResult = await card.tokenize();
				if (tokenResult.status !== 'OK') {
					throw new Error(tokenResult.errors?.[0]?.message || 'Card tokenisation failed');
				}

				const buyerName  = document.getElementById('buyer-name')?.value || '';
				const buyerEmail = document.getElementById('buyer-email')?.value || '';

				const res = await fetch('/api/square/payment', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						sourceId: tokenResult.token,
						amountCents: totalCents,
						currency: 'AUD',
						note: orderItems.map(i => `${i.title} x${i.qty || 1}`).join(', '),
						buyerName,
						buyerEmail,
					}),
				});

				const data = await res.json();

				if (!res.ok || data.error) {
					throw new Error(data.error || 'Payment failed');
				}

				// Success
				if (paySuccess) paySuccess.style.display = 'flex';
				document.getElementById('payment-form')?.querySelectorAll('input, button').forEach(el => (el as HTMLInputElement).disabled = true);
				localStorage.removeItem('db_cart');
				window.dispatchEvent(new Event('db-cart-updated'));

			} catch (err) {
				if (payError) {
					payError.textContent = err instanceof Error ? err.message : 'Payment failed — please try again.';
					payError.style.display = 'flex';
				}
				if (payBtn) payBtn.disabled = false;
				if (payBtnText) payBtnText.textContent = totalCents > 0 ? `Pay ${toCurrency(totalCents)}` : 'Pay';
			} finally {
				if (paySpinner) paySpinner.style.display = 'none';
			}
		});
	}

	initSquare();
}
</script>

<style>
	.checkout-wrap {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 3rem;
		align-items: start;
		max-width: 860px;
	}

	.order-panel, .payment-panel {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		box-shadow: var(--shadow);
	}

	.panel-title {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line);
		font-family: "DM Sans", sans-serif;
		letter-spacing: 0;
	}

	.order-item {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--line);
	}

	.order-item-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.order-item-name { font-size: 0.9rem; font-weight: 500; }

	.order-item-qty { font-size: 0.78rem; color: var(--muted); }

	.order-item-price { font-family: "Fraunces", serif; font-weight: 600; white-space: nowrap; }

	.order-divider { height: 1px; background: var(--line); margin: 0.75rem 0; }

	.order-total-row {
		display: flex;
		justify-content: space-between;
		font-weight: 600;
		font-size: 1rem;
	}

	.order-total { font-family: "Fraunces", serif; font-size: 1.2rem; }

	.order-secure-note {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.72rem;
		color: var(--muted);
		margin-top: 1.25rem;
	}

	/* Payment form */
	.field-group { margin-bottom: 1.1rem; }

	.field-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 0.4rem;
	}

	.field-input {
		width: 100%;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		font-family: "DM Sans", sans-serif;
		font-size: 0.9rem;
		color: var(--text);
		background: var(--bg);
		transition: border-color 0.2s;
		outline: none;
	}

	.field-input:focus { border-color: var(--text); }

	.card-container {
		min-height: 60px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 0.75rem;
		background: var(--bg);
	}

	.payment-error {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: #fff5f5;
		border: 1px solid #fcc;
		color: #c0503a;
		padding: 0.65rem 0.9rem;
		border-radius: var(--radius);
		font-size: 0.875rem;
		margin-bottom: 1rem;
	}

	.payment-success {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: #f0fff4;
		border: 1px solid #b2e4c2;
		color: #276845;
		padding: 0.65rem 0.9rem;
		border-radius: var(--radius);
		font-size: 0.875rem;
		margin-bottom: 1rem;
	}

	.pay-btn {
		width: 100%;
		padding: 0.85rem 1.5rem;
		background: var(--bg-dark);
		color: var(--text-inv);
		border: none;
		border-radius: var(--radius);
		font-family: "DM Sans", sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: background 0.2s, opacity 0.2s;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.pay-btn:hover:not(:disabled) { background: var(--accent); }
	.pay-btn:disabled { opacity: 0.55; cursor: not-allowed; }

	@keyframes spin { to { transform: rotate(360deg); } }

	.pay-spinner {
		width: 14px;
		height: 14px;
		border: 2px solid rgba(255,255,255,0.3);
		border-top-color: #fff;
		border-radius: 50%;
		animation: spin 0.7s linear infinite;
	}

	.pay-disclaimer {
		font-size: 0.72rem;
		color: var(--muted);
		text-align: center;
		margin-top: 0.75rem;
		line-height: 1.5;
	}

	.config-warning {
		background: #fffdf0;
		border: 1px solid #f0e080;
		border-radius: var(--radius);
		padding: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--text);
	}

	.config-warning code {
		background: #f5f0e0;
		padding: 0.1em 0.35em;
		border-radius: 3px;
		font-size: 0.85em;
	}

	@media (max-width: 700px) {
		.checkout-wrap { grid-template-columns: 1fr; }
	}
</style>
