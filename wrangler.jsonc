{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dapperblokes",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dapperblokes-hair",
			"database_id": "58041d61-baf4-4d63-b694-53b3e062fe80",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dapperblokes-hair-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b998c6e9431d43fe943a27aa543c59d9"
		}
	],
}
